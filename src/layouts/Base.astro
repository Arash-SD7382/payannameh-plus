---
import '../styles/global.css';
import { contact } from '../data/services';
const { title, description = 'Payannameh Plus: thesis, article, research, data and programming support, with documented project case studies.', jsonld, image = '/images/logo.png' } = Astro.props;
const full = title === 'Payannameh Plus' ? title : `${title} | Payannameh Plus`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const links = [['Projects','/projects'],['Services','/services'],['About','/about']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{full}</title><meta name="description" content={description}>
<link rel="canonical" href={canonical}><link rel="icon" href="/images/mark.png">
<meta property="og:title" content={full}><meta property="og:description" content={description}>
<meta property="og:type" content={jsonld ? 'article' : 'website'}><meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(image, Astro.site)}><meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;600&family=Vazirmatn:wght@400;600&display=swap" rel="stylesheet">
<script is:inline>try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
<header class="site"><div class="wrap">
<a class="brand" href="/"><img src="/images/logo.png" alt="Payannameh Plus logo" width="52" height="52"></a>
<nav class="main" id="nav" aria-label="Main">{links.map(([n,h]) => <a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{n}</a>)}</nav>
<button class="icon-btn" id="theme" aria-label="Toggle dark mode">◐</button>
<button class="icon-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav">☰</button>
</div></header>
<main><slot /></main>
<footer class="site"><div class="wrap">
<div><h2>Payannameh Plus</h2><p>Advancing Academic Excellence</p></div>
<div><h2>Explore</h2><ul>{links.map(([n,h]) => <li><a href={h}>{n}</a></li>)}</ul></div>
<div><h2>Contact</h2><ul><li>Phone: <a href={`tel:${contact.phone}`}>{contact.phone}</a></li></ul></div>
</div><div class="wrap" style="margin-top:1.5rem;display:block"><small>© {new Date().getFullYear()} Payannameh Plus. All rights reserved.</small></div></footer>
<script is:inline>
var m=document.getElementById('menu-btn'),n=document.getElementById('nav');
m.addEventListener('click',function(){var o=n.classList.toggle('open');m.setAttribute('aria-expanded',o)});
document.getElementById('theme').addEventListener('click',function(){var d=document.documentElement,c=d.dataset.theme||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'),x=c==='dark'?'light':'dark';d.dataset.theme=x;try{localStorage.setItem('theme',x)}catch(e){}});
</script>
</body></html>
