---
import '../styles/global.css';
import { team } from '../data/services';
import ContactLinks from '../components/ContactLinks.astro';
import { ui, href } from '../i18n/ui';
const { lang = 'fa', title, description, jsonld, image = '/images/logo.png', alt, noindex = false } = Astro.props;
const t = ui[lang]; const other = lang === 'fa' ? 'en' : 'fa';
const full = title === t.brand ? title : `${title} | ${t.brand}`;
const desc = description || t.metaDesc;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/^\/en/, '') || '/';
const links = [[t.nav.projects, '/projects'], [t.nav.services, '/services'], [t.nav.about, '/about'], [t.nav.contact, '/contact']];
const switchTo = alt || href(other, '/');
---
<!doctype html>
<html lang={lang} dir={t.dir}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{full}</title><meta name="description" content={desc}>
{noindex && <meta name="robots" content="noindex">}<link rel="canonical" href={canonical}><link rel="icon" href="/images/mark.png">
{alt && <link rel="alternate" hreflang={lang} href={canonical}>}
{alt && <link rel="alternate" hreflang={other} href={new URL(alt, Astro.site)}>}
<meta property="og:title" content={full}><meta property="og:description" content={desc}>
<meta property="og:type" content={jsonld && jsonld['@type'] === 'Article' ? 'article' : 'website'}><meta property="og:url" content={canonical}>
<meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'}>
<meta property="og:image" content={new URL(image, Astro.site)}><meta name="twitter:card" content="summary_large_image">
{lang === 'fa'
  ? <><link rel="preload" href="/fonts/vazirmatn-arabic-wght-normal.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/fonts/vazirmatn-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin></>
  : <><link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin></>}
<script is:inline>try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
<header class="site"><div class="wrap">
<a class="brand" href={href(lang, '/')}><img src="/images/logo.png" alt={t.brand} width="52" height="52" data-cms-logo></a>
<nav class="main" id="nav" aria-label="Main">{links.map(([n, p]) => <a href={href(lang, p)} aria-current={path.startsWith(p) ? 'page' : undefined} data-cms={`nav.${p.slice(1)}`}>{n}</a>)}</nav>
<a class="lang" href={switchTo} hreflang={other} lang={other}>{t.switch}</a>
<label class="theme nt" for="theme"><span class="theme__toggle-wrap"><input id="theme" class="theme__toggle" type="checkbox" role="switch" name="theme" aria-label="Toggle dark mode" autocomplete="off"><span class="theme__icon"><span class="theme__icon-part"></span><span class="theme__icon-part"></span><span class="theme__icon-part"></span><span class="theme__icon-part"></span><span class="theme__icon-part"></span><span class="theme__icon-part"></span><span class="theme__icon-part"></span><span class="theme__icon-part"></span><span class="theme__icon-part"></span></span></span></label>
<button class="icon-btn hb" id="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="nav"><span class="hb-i" aria-hidden="true"><span class="hb-l"></span><span class="hb-l"></span><span class="hb-l"></span></span></button>
</div></header>
<main><slot /></main>
<footer class="site"><div class="wrap">
<div><h2>{t.brand}</h2><p data-cms="tagline">{t.tagline}</p></div>
<div><h2 data-cms="explore">{t.explore}</h2><ul>{links.map(([n, p]) => <li><a href={href(lang, p)} data-cms={`nav.${p.slice(1)}`}>{n}</a></li>)}</ul></div>
<div><h2 data-cms="contact">{t.contact}</h2><ul>{team.map((p, i) => <li><strong data-cms={`team.${i}.name`}>{p[lang]}</strong><br><a class="tel" href={`tel:${p.phone}`} data-ti={i} data-ck="phone"><bdi dir="ltr" data-ti={i} data-ct="phone">{p.phone}</bdi></a><br><ContactLinks person={p} who={p[lang]} size="sm" idx={i} noPhone={true} /></li>)}</ul></div>
</div><div class="wrap" style="margin-top:1.5rem;display:block"><small>© {new Date().getFullYear()} {t.brand}. <span data-cms="rights">{t.rights}</span></small></div></footer>
<script is:inline>
(function(){
var m=document.getElementById('menu-btn'),n=document.getElementById('nav');
function setMenu(o){n.classList.toggle('open',o);m.setAttribute('aria-expanded',o)}
m.addEventListener('click',function(e){e.stopPropagation();setMenu(!n.classList.contains('open'))});
document.addEventListener('click',function(e){if(n.classList.contains('open')&&!n.contains(e.target))setMenu(false)});
document.addEventListener('keydown',function(e){if(e.key==='Escape')setMenu(false)});
n.addEventListener('click',function(e){if(e.target.closest('a'))setMenu(false)});
var tg=document.getElementById('theme'),tl=tg.closest('label'),dd=document.documentElement,mq=matchMedia('(prefers-color-scheme:dark)');
function curTheme(){return dd.dataset.theme||(mq.matches?'dark':'light')}
function syncTheme(){tg.checked=curTheme()==='dark'}
syncTheme();requestAnimationFrame(function(){requestAnimationFrame(function(){tl.classList.remove('nt')})});
tg.addEventListener('change',function(){var x=tg.checked?'dark':'light';dd.dataset.theme=x;try{localStorage.setItem('theme',x)}catch(e){}});
window.addEventListener('pageshow',syncTheme);
if(mq.addEventListener)mq.addEventListener('change',function(){if(!dd.dataset.theme)syncTheme()});
})();
</script>
<script src="/cms.js" defer></script>
</body></html>
