---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
const t = ui.fa; const e = ui.en;
---
<Base lang="fa" title="404" alt="/en/"><section><div class="wrap" style="text-align:center">
<h1>404</h1><p class="muted">{t.notFound} {t.notFoundText}</p><p class="muted" dir="ltr" lang="en">{e.notFoundText}</p>
<div class="actions" style="justify-content:center"><a class="btn" href="/">{t.backHome}</a><a class="btn ghost" href="/en/" lang="en">{e.backHome}</a></div>
</div></section></Base>
