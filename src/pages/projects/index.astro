---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categories } from '../../content/config';
const all = (await getCollection('projects')).sort((a,b)=>+b.data.date-+a.data.date);
---
<Base title="Projects" description="Browse completed projects with video, steps and results.">
<section><div class="wrap">
<h1>Projects</h1>
<div class="toolbar">
<input id="q" type="search" placeholder="Search by title, category or topic" aria-label="Search projects">
<select id="cat" aria-label="Filter by category"><option value="">All categories</option>{categories.map(c=><option>{c}</option>)}</select>
<select id="sort" aria-label="Sort"><option value="new">Newest first</option><option value="old">Oldest first</option></select>
</div>
<div class="grid" id="list">{all.map(p => <ProjectCard p={p} />)}</div>
<div class="empty" id="none" hidden>No projects match your search. Try a different word or category.</div>
</div></section>
<script is:inline>
var q=document.getElementById('q'),c=document.getElementById('cat'),s=document.getElementById('sort'),l=document.getElementById('list'),n=document.getElementById('none');
var cards=[].slice.call(l.children),u=new URLSearchParams(location.search);if(u.get('cat'))c.value=u.get('cat');
function run(){var t=q.value.trim().toLowerCase(),shown=0;
cards.sort(function(a,b){return s.value==='new'?b.dataset.date-a.dataset.date:a.dataset.date-b.dataset.date}).forEach(function(e){l.appendChild(e);
var ok=(!c.value||e.dataset.cat===c.value)&&(!t||(e.dataset.title+' '+e.dataset.cat.toLowerCase()+' '+e.dataset.text).indexOf(t)>-1);e.hidden=!ok;if(ok)shown++});
n.hidden=shown>0}
[q,c,s].forEach(function(e){e.addEventListener('input',run)});run();
</script>
</Base>
