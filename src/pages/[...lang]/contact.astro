---
import Base from '../../layouts/Base.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import { team } from '../../data/services';
import { ui, href, bothLangs } from '../../i18n/ui';
export function getStaticPaths() { return bothLangs(); }
const { lang } = Astro.props; const t = ui[lang]; const other = lang === 'fa' ? 'en' : 'fa';
---
<Base lang={lang} title={t.contactUs} description={t.contactDesc} alt={href(other, '/contact')}>
<section><div class="wrap"><h1 data-cms="contactUs">{t.contactUs}</h1><p class="muted" style="max-width:60ch" data-cms="contactIntro">{t.contactIntro}</p>
<div class="info-card">
<div class="info-item"><span class="info-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><strong data-cms="hoursTitle">{t.hoursTitle}</strong><span data-cms="hoursText">{t.hoursText}</span></div></div>
<div class="info-item"><span class="info-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.5 7.2L4 20l1-4.2A8 8 0 1 1 21 12z"/></svg></span><div><strong data-cms="replyTitle">{t.replyTitle}</strong><span data-cms="replyText">{t.replyText}</span></div></div>
<div class="info-item"><span class="info-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H8a2.5 2.5 0 0 1 0-5c3 0 4 5 4 5zM12 7h4a2.5 2.5 0 0 0 0-5c-3 0-4 5-4 5z"/></svg></span><div><strong data-cms="freeTitle">{t.freeTitle}</strong><span data-cms="freeText">{t.freeText}</span></div></div>
</div>
<div class="grid" style="margin-top:1.5rem">{team.map((p, i) => <div class="svc"><h2 style="font-size:1.3rem" data-cms={`team.${i}.name`}>{p[lang]}</h2>
<p style="margin:.5rem 0 1rem"><a class="tel" href={`tel:${p.phone}`} data-ti={i} data-ck="phone"><bdi dir="ltr" data-ti={i} data-ct="phone">{p.phone}</bdi></a></p>
<ContactLinks person={p} who={p[lang]} idx={i} noPhone={true} /></div>)}</div>
</div></section></Base>
