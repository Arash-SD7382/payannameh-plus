---
import Base from '../../layouts/Base.astro';
import { groups } from '../../data/services';
import { ui, href, bothLangs } from '../../i18n/ui';
export function getStaticPaths() { return bothLangs(); }
const { lang } = Astro.props; const t = ui[lang]; const other = lang === 'fa' ? 'en' : 'fa';
---
<Base lang={lang} title={t.nav.services} description={t.servicesDesc} alt={href(other, '/services')}>
<section><div class="wrap"><h1>{t.nav.services}</h1><p class="muted" style="max-width:60ch">{t.servicesIntro}</p>
<div class="grid" style="margin-top:2rem">{groups.map(g => <div class="svc"><h2 style="font-size:1.3rem">{g[lang]}</h2><ul>{g.items.map(i => <li>{i[lang]}</li>)}</ul></div>)}</div>
<div class="actions"><a class="btn" href={href(lang, '/contact')}>{t.contactUs}</a></div></div></section></Base>
